# Copy to .env (npm start loads it automatically) or set these in your host's dashboard.

# Anthropic API key. Leave empty to run in demo mode (no model calls, labelled placeholder runs).
ANTHROPIC_API_KEY=

# Default model, used by agents whose job card says "Default". Each agent can pick its own
# model on its job card (Fable 5.2, Opus 5.5, Sonnet 5.5, Haiku 5.5).
MODEL=claude-opus-5-5

# How hard the model works per step: low | medium | high | xhigh | max. Higher costs more tokens.
EFFORT=medium

# If set, the whole app (page and API) asks for this password via HTTP basic auth. Any username works.
APP_PASSWORD=

# Port to listen on. Most hosts set this for you.
PORT=3000

# Time zone for the night shift clock, e.g. Europe/London, America/New_York.
TZ=UTC

# Where db.json lives. Point this at your host's persistent disk mount.
# DATA_DIR=/var/data

# Set to "off" to stop the API retrying a safety-declined request on a fallback model.
# REFUSAL_FALLBACK=off
